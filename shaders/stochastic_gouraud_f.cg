// Screen-space 2x2 ordered coordinate-dithered sampling for VDP1 sprites
// that also carry Saturn Gouraud color.  This is intentionally separate from
// the world-polygon shader so enabling the presentation filter cannot change
// the established 3D renderer path.
float4 main(
    float2 vTexcoord : TEXCOORD0,
    float3 vShade : TEXCOORD1,
    float4 fragCoord : WPOS,
    uniform sampler2D tex : TEXUNIT0,
#if LAGI_DITHER_LOOKUP
    uniform sampler2D ditherOffsets : TEXUNIT1,
#endif
    uniform float4 textureSize)
{
#if LAGI_DITHER_LOOKUP
    float2 offset = tex2D(ditherOffsets, fragCoord.xy * 0.5f).rg;
#else
    float2 pixel = floor(fragCoord.xy);
    float2 parity = pixel - 2.0f * floor(pixel * 0.5f);
    float both = parity.x * parity.y;
    float du = 0.25f + 0.25f * parity.x + 0.50f * parity.y - both;
    float dv = 0.75f * parity.x + 0.50f * parity.y - both;
    float2 offset = float2(du, dv) - 0.5f;
#endif

    // Let POINT perform texel selection; clamp to texel centers at edges.
    float2 halfTexel = 0.5f * textureSize.zw;
    float2 sampleUv = clamp(
        saturate(vTexcoord) + offset * textureSize.zw,
        halfTexel, 1.0f - halfTexel);
    float4 color = tex2D(tex, sampleUv);
    if (color.a < 0.5f)
        discard;

    float3 light5 = clamp(vShade * 31.0f + 16.0f, 0.0f, 31.0f);
    light5 = floor(light5 + 0.5f);
    float3 correction5 = light5 - 16.0f;

    float3 base5 = floor(color.rgb * 31.0f + 0.5f);
    float3 result5 = clamp(base5 + correction5, 0.0f, 31.0f);
    return float4(result5 / 31.0f, color.a);
}
