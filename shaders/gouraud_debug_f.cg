float cross2d(float2 a, float2 b)
{
    return a.x * b.y - a.y * b.x;
}

float computeU(float2 h, float2 e, float2 f, float2 g, float v)
{
    float2 num = h - f * v;
    float2 den = e + g * v;
    return abs(den.x) > abs(den.y)
        ? num.x / den.x
        : num.y / den.y;
}

float2 inverseBilinear(float2 p, float2 a, float2 b, float2 c, float2 d)
{
    float2 e = b - a;
    float2 f = d - a;
    float2 g = a - b + c - d;
    float2 h = p - a;

    float k2 = cross2d(g, f);
    float k1 = cross2d(e, f) + cross2d(h, g);
    float k0 = cross2d(h, e);

    if (abs(k2) < 0.0001f)
    {
        if (abs(k1) < 0.0001f)
            return float2(0.5f, 0.5f);

        float v = -k0 / k1;
        return float2(computeU(h, e, f, g, v), v);
    }

    float disc = max(0.0f, k1 * k1 - 4.0f * k0 * k2);
    float root = sqrt(disc);

    float v1 = (-k1 - root) / (2.0f * k2);
    float v2 = (-k1 + root) / (2.0f * k2);
    float u1 = computeU(h, e, f, g, v1);
    float u2 = computeU(h, e, f, g, v2);

    float d1 = max(max(-u1, u1 - 1.0f), max(-v1, v1 - 1.0f));
    float d2 = max(max(-u2, u2 - 1.0f), max(-v2, v2 - 1.0f));

    return d1 <= d2 ? float2(u1, v1) : float2(u2, v2);
}

float4 main(
    float2 vTexcoord : TEXCOORD0,
    float4 fragCoord : WPOS,
    uniform float4 quadScreen01,
    uniform float4 quadScreen23,
    uniform float4 gouraudR,
    uniform float4 gouraudG,
    uniform float4 gouraudB)
{
    float2 p0 = quadScreen01.xy;
    float2 p1 = quadScreen01.zw;
    float2 p2 = quadScreen23.xy;
    float2 p3 = quadScreen23.zw;

    float2 st = saturate(inverseBilinear(fragCoord.xy, p0, p1, p2, p3));

    float r = lerp(lerp(gouraudR.x, gouraudR.y, st.x),
                   lerp(gouraudR.w, gouraudR.z, st.x), st.y);
    float g = lerp(lerp(gouraudG.x, gouraudG.y, st.x),
                   lerp(gouraudG.w, gouraudG.z, st.x), st.y);
    float b = lerp(lerp(gouraudB.x, gouraudB.y, st.x),
                   lerp(gouraudB.w, gouraudB.z, st.x), st.y);

    // Gouraud offsets are stored as (g5 - 16) / 31. Reconstruct the
    // interpolated 0..31 lighting value, quantize it exactly like the final
    // RGB555 output path, then average RGB only after quantization. This makes
    // Saturn-style lighting bands directly visible in the diagnostic.
    float3 light5 =
        clamp(float3(r, g, b) * 31.0f + 16.0f, 0.0f, 31.0f);
    light5 = floor(light5 + 0.5f);

    float gray5 =
        floor((light5.r + light5.g + light5.b) / 3.0f + 0.5f);
    float gray = gray5 / 31.0f;

    return float4(gray, gray, gray, 1.0f);
}
