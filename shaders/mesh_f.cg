// Saturn VDP1 mesh primitive diagnostic.
// Preserve the source texture silhouette but temporarily bypass the
// screen-space checkerboard test. If Edge's shadow becomes visible on
// hardware, the remaining bug is isolated to the mesh parity/WPOS path.
float4 main(
    float2 vTexcoord : TEXCOORD0,
    uniform sampler2D tex)
{
    float4 color = tex2D(tex, vTexcoord);
    if (color.a < 0.5f)
        discard;

    return float4(color.rgb, 1.0f);
}
