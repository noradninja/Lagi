// Saturn VDP1 mesh primitive.
// The source texture still matters: it defines the sprite/polygon silhouette
// (Edge's shadow is an oval alpha mask). Mesh mode then removes alternating
// destination pixels from that already-masked shape.
float4 main(
    float2 vTexcoord : TEXCOORD0,
    float4 fragCoord : WPOS,
    uniform sampler2D tex)
{
    float4 color = tex2D(tex, vTexcoord);
    if (color.a < 0.5f)
        discard;

    float parity = frac(
        (floor(fragCoord.x) + floor(fragCoord.y)) * 0.5f);
    if (parity >= 0.5f)
        discard;

    return float4(color.rgb, 1.0f);
}
