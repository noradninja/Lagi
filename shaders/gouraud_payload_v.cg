// Per-quad Saturn Gouraud payload vertex shader.
//
// Each generated triangle vertex carries the same original Saturn quad
// corners and RGB555 Gouraud values. Hoist the four projected-edge reciprocal
// Y deltas here so both final fragment paths replace per-pixel divisions with
// multiplications while retaining the exact scanline edge selection.

float safeInverse(float value)
{
    if (abs(value) < 0.0001f)
        return 0.0f;
    return 1.0f / value;
}

void main(
    float3 aPosition,
    float2 aTexcoord,
    float4 aQuadScreen01,
    float4 aQuadScreen23,
    float4 aGouraudR,
    float4 aGouraudG,
    float4 aGouraudB,
    uniform float4x4 wvp,
    float4 out vPosition : POSITION,
    float2 out vTexcoord : TEXCOORD0,
    float4 out vInverse0 : TEXCOORD1,
    float4 out vInverse1 : TEXCOORD2,
    float4 out vEdgeInverseDy : TEXCOORD3,
    float4 out vGouraudR : TEXCOORD4,
    float4 out vGouraudG : TEXCOORD5,
    float4 out vGouraudB : TEXCOORD6)
{
    vPosition = mul(float4(aPosition, 1.0f), wvp);
    vTexcoord = aTexcoord;

    float2 a = aQuadScreen01.xy;
    float2 b = aQuadScreen01.zw;
    float2 c = aQuadScreen23.xy;
    float2 d = aQuadScreen23.zw;

    float2 e = b - a;
    float2 f = d - a;
    float2 g = a - b + c - d;

    vInverse0 = float4(a, e);
    vInverse1 = float4(f, g);
    vEdgeInverseDy = float4(
        safeInverse(b.y - a.y),
        safeInverse(c.y - b.y),
        safeInverse(d.y - c.y),
        safeInverse(a.y - d.y));

    vGouraudR = aGouraudR;
    vGouraudG = aGouraudG;
    vGouraudB = aGouraudB;
}
