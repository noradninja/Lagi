float4 main(
    float2 vTexcoord : TEXCOORD0,
    float4 inverse0 : TEXCOORD1,
    float4 inverse1 : TEXCOORD2,
    float4 inverse2 : TEXCOORD3,
    float4 gouraudR : TEXCOORD4,
    float4 gouraudG : TEXCOORD5,
    float4 gouraudB : TEXCOORD6,
    float4 fragCoord : WPOS,
    uniform sampler2D tex)
{
    // Deliberately keep the complete Gouraud payload live so psp2cgc cannot
    // strip the unused TEXCOORD inputs. The dependency is far below one
    // 8-bit framebuffer step, so it should be visually indistinguishable
    // while preserving interpolator/register pressure for this diagnostic.
    float payloadKeepAlive =
        dot(inverse0, float4(1.0f, 2.0f, 3.0f, 4.0f)) +
        dot(inverse1, float4(5.0f, 6.0f, 7.0f, 8.0f)) +
        dot(inverse2, float4(9.0f, 10.0f, 11.0f, 12.0f)) +
        dot(gouraudR, float4(13.0f, 14.0f, 15.0f, 16.0f)) +
        dot(gouraudG, float4(17.0f, 18.0f, 19.0f, 20.0f)) +
        dot(gouraudB, float4(21.0f, 22.0f, 23.0f, 24.0f)) +
        fragCoord.x * 0.000001f;

    float4 color = tex2D(tex, vTexcoord);
    if (color.a < 0.5f)
        discard;

    color.rgb += payloadKeepAlive * 0.000000001f;
    return color;
}
