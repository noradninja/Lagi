// Unreal-inspired 2x2 ordered coordinate-dithered nearest sampling.
// Uses the published four coordinated U/V offsets, not independent hashes.
// textureSize = source width/height and their CPU-computed reciprocals.
// WPOS is the rasterizer-provided destination pixel position.  Deriving the
// pattern from UVs makes its spacing follow/distort with sprite coordinates.
// Sampler state must be POINT; one texture fetch per output fragment.
float4 main(float2 uv : TEXCOORD0, float4 fragCoord : WPOS,
            uniform sampler2D tex,
            uniform float4 textureSize)
{
    float2 pixel = floor(fragCoord.xy);
    float2 parity = pixel - 2.0f * floor(pixel * 0.5f);
    // Screen parity: (0,0)=(.25,0), (1,0)=(.50,.75),
    //                (0,1)=(.75,.50), (1,1)=(0,.25).
    float both = parity.x * parity.y;
    float du = 0.25f + 0.25f * parity.x + 0.50f * parity.y - both;
    float dv = 0.75f * parity.x + 0.50f * parity.y - both;
    float2 source = saturate(uv) * textureSize.xy;
    float2 texel = clamp(floor(source + float2(du,dv) - 0.5f),
                         float2(0.0f,0.0f), textureSize.xy - 1.0f);
    float4 color = tex2D(tex, (texel + 0.5f) * textureSize.zw);
    if (color.a < 0.5f) discard;
    return color;
}
