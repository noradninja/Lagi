// Stable 4x4 ordered one-tap approximation to bilinear on SGX.
// textureInfo = (source width, source height, destination width, destination height).
// Texture state MUST use point filtering.
float4 main(float2 uv : TEXCOORD0, uniform sampler2D tex, uniform float4 textureInfo)
{
    float2 p = saturate(uv) * textureInfo.xy - 0.5f;
    float2 baseTexel = floor(p);
    float2 w = frac(p);
    float2 screenPixel = floor(saturate(uv) * textureInfo.zw);
    float2 cell = screenPixel - 4.0f * floor(screenPixel / 4.0f);
    // Two decorrelated 4x4 Bayer threshold sequences.
    float2 a = floor(cell / 2.0f);
    float2 b = cell - 2.0f * a;
    float thresholdX = (dot(b, float2(2.0f, 3.0f)) + dot(a, float2(0.0f, 1.0f)) * 4.0f + 0.5f) / 16.0f;
    float thresholdY = frac(thresholdX + 0.4375f);
    float2 choice = float2(w.x > thresholdX ? 1.0f : 0.0f,
                           w.y > thresholdY ? 1.0f : 0.0f);
    float2 texel = clamp(baseTexel + choice, float2(0.0f,0.0f), textureInfo.xy - 1.0f);
    float4 color = tex2D(tex, (texel + 0.5f) / textureInfo.xy);
    if (color.a < 0.5f) discard;
    return color;
}
