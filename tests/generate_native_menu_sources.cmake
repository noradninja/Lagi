# Exercise the actual production adapter, without configuring/building a VPK.
cmake_minimum_required(VERSION 3.18)
if(NOT DEFINED REPO_ROOT OR NOT DEFINED LAGI_AZEL_SOURCE_ROOT)
 message(FATAL_ERROR "Pass REPO_ROOT and LAGI_AZEL_SOURCE_ROOT")
endif()
file(READ "${REPO_ROOT}/CMakeLists.txt" production_cmake)
string(FIND "${production_cmake}" "function(lagi_prepare_upstream_azel_source " begin)
if(begin LESS 0)
 message(FATAL_ERROR "Production source adapter function missing")
endif()
string(SUBSTRING "${production_cmake}" ${begin} -1 adapter_tail)
string(FIND "${adapter_tail}" "endfunction()" end)
if(end LESS 0)
 message(FATAL_ERROR "Production source adapter function end missing")
endif()
math(EXPR length "${end} + 13")
string(SUBSTRING "${adapter_tail}" 0 ${length} adapter)
# Build-graph metadata is unavailable in script mode; it does not affect the
# generated source. Leave all production text transformations unchanged.
function(set_source_files_properties)
endfunction()
cmake_language(EVAL CODE "${adapter}")
set(LAGI_AZEL_GENERATED_ROOT "${CMAKE_CURRENT_BINARY_DIR}/azel_upstream")
file(MAKE_DIRECTORY "${LAGI_AZEL_GENERATED_ROOT}")
foreach(source IN ITEMS "field/field_a3/o_fld_a3.cpp" "field/fieldRadar.cpp" "LCS.cpp" "kernel/dialogTask.cpp" "VDP2.cpp" "3dEngine.cpp" "field/fieldDragon.cpp")
 lagi_prepare_upstream_azel_source("${source}" generated)
 message(STATUS "Generated actual native adapter: ${generated}")
endforeach()
