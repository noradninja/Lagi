# Preserve native flag semantics, not Saturn byte offsets in C++ work areas.
function(lagi_adapt_life_meter_flags relative_path input_text output_var)
 set(expected 0)
 if(relative_path STREQUAL "battle/BTL_A3/urchin.cpp")
  set(expected 5)
 elseif(relative_path STREQUAL "battle/BTL_A3/baldorQueen.cpp" OR
        relative_path STREQUAL "battle/BTL_A5/BTL_A5_single.cpp")
  set(expected 2)
 elseif(relative_path STREQUAL "battle/BTL_A5/BTL_A5_variant.cpp")
  set(expected 3)
 endif()
 set(text "${input_text}")
 if(expected)
  string(REGEX MATCHALL "\\[0x31\\]" old_sites "${text}")
  list(LENGTH old_sites count)
  if(NOT count EQUAL expected)
   message(FATAL_ERROR "Native life-meter flag sites changed in ${relative_path}: ${count}, expected ${expected}")
  endif()
  foreach(pointer "lifeMeter" "pThis->mC8" "pThis->m40_enemyLifeMeterTask" "pThis->mAC_lifeMeter")
   string(REPLACE "((u8*)${pointer})[0x31]"
    "static_cast<sEnemyLifeMeterTask*>(${pointer})->m31" text "${text}")
  endforeach()
  if(text MATCHES "\\[0x31\\]")
   message(FATAL_ERROR "Unadapted native life-meter byte write in ${relative_path}")
  endif()
  string(REPLACE "#include \"PDS.h\""
   "#include \"PDS.h\"\n#include \"battle/battleEnemyLifeMeter.h\"" text "${text}")
 endif()
 set(${output_var} "${text}" PARENT_SCOPE)
endfunction()
